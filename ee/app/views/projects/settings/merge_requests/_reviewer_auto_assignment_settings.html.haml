- return unless @project.reviewer_auto_assignment_available?

- beta_badge = render(Pajamas::ExperimentBadgeComponent.new(type: :beta))

= render ::Layouts::SettingsSectionComponent.new(s_('MergeRequests|Automatic reviewer assignment'),
  id: 'merge-request-reviewer-auto-assignment-settings',
  testid: 'reviewer-auto-assignment-settings',
  options: { class: 'merge-requests-feature' }) do |c|
  - c.with_description do
    = s_('MergeRequests|Automatically assign reviewers when a merge request is ready.')
  - c.with_body do
    = gitlab_ui_form_for @project, url: project_settings_merge_requests_path(@project), authenticity_token: true do |f|
      .form-group
        = f.fields_for :project_setting do |settings|
          = settings.gitlab_ui_checkbox_component :reviewer_assignment_strategy,
            safe_join([s_('MergeRequests|Automatically assign code owners as reviewers'), ' ', beta_badge]),
            help_text: s_('MergeRequests|Code owners are automatically assigned as reviewers when a merge request is marked as ready. Draft merge requests are excluded.'),
            checkbox_options: { checked: @project.project_setting.reviewer_assignment_code_owners? },
            checked_value: 'code_owners',
            unchecked_value: 'disabled'
      = f.submit _('Save changes'), pajamas_button: true
