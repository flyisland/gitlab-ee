- return unless ::Ai::Orbit::Settings.orbit_in_duo_on?(current_user)

.form-group.gl-mt-5.gl-mb-6{ data: { testid: 'orbit-settings-section' } }
  %span.label-bold.gl-flex.gl-items-center.gl-gap-2
    = s_('Preferences|Orbit in GitLab Duo')
    = gl_badge_tag s_('Preferences|Beta'), variant: :info, size: :sm
  .form-text.gl-text-subtle.gl-mt-0
    = s_('Preferences|Orbit powers GitLab Duo chat and agents across your projects. Choose which Orbit-powered features to use.')

  .gl-mt-3{ data: { testid: 'orbit-subsettings' } }
    = f.gitlab_ui_checkbox_component :orbit_agentic_chat_enabled,
      s_('Preferences|Agentic Chat'),
      help_text: s_('Preferences|Make Orbit tools available in agentic chat.')
    = f.gitlab_ui_checkbox_component :orbit_agent_enabled,
      s_('Preferences|Orbit Agent'),
      help_text: s_('Preferences|Make the standalone Orbit agent available in GitLab Duo.')
    = f.gitlab_ui_checkbox_component :orbit_other_foundational_agents_enabled,
      s_('Preferences|Other Foundational Agents'),
      help_text: s_('Preferences|Make Orbit tools available to non-chat foundational agents (e.g. software development, security analyst).')
    = f.gitlab_ui_checkbox_component :orbit_custom_agents_enabled,
      s_('Preferences|Custom Agents'),
      help_text: s_('Preferences|Make Orbit tools available to user-built custom agents.')
