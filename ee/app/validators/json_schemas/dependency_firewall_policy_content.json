{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Policy content for dependency_firewall_policy type",
  "type": "object",
  "required": [
    "name",
    "enabled",
    "enforcement_type",
    "rules"
  ],
  "properties": {
    "name": {
      "description": "Name of the policy",
      "minLength": 1,
      "maxLength": 255,
      "type": "string"
    },
    "description": {
      "description": "Specifies the longer description of the policy.",
      "type": "string",
      "maxLength": 1000000
    },
    "enabled": {
      "description": "Whether to enforce this policy or not.",
      "type": "boolean"
    },
    "enforcement_type": {
      "description": "Specifies how this policy should be enforced. 'enforced' blocks the download when a rule matches. 'warn' allows the download but records a warning.",
      "type": "string",
      "enum": [
        "enforced",
        "warn"
      ]
    },
    "rules": {
      "type": "array",
      "description": "Specifies rules for dependency firewall enforcement",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "license"
            ],
            "description": "Specifies the type of the rule. Currently only 'license' is supported."
          },
          "denied": {
            "type": "array",
            "description": "List of licenses that are denied. Mutually exclusive with 'allowed'.",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255,
                  "description": "The name of the license (SPDX human-readable name)"
                }
              },
              "additionalProperties": false
            }
          },
          "allowed": {
            "type": "array",
            "description": "List of licenses that are allowed. Mutually exclusive with 'denied'.",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255,
                  "description": "The name of the license (SPDX human-readable name)"
                }
              },
              "additionalProperties": false
            }
          },
          "exceptions": {
            "type": "array",
            "description": "List of package exceptions (PURLs) that bypass this rule",
            "items": {
              "type": "object",
              "required": [
                "purl"
              ],
              "properties": {
                "purl": {
                  "type": "string",
                  "pattern": "^pkg:",
                  "minLength": 1,
                  "maxLength": 1024,
                  "description": "Package URL (PURL) format for the exception"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "type",
              "denied"
            ]
          },
          {
            "required": [
              "type",
              "allowed"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    "bypass_settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "access_tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
