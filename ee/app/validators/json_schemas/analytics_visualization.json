{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/AnalyticsVisualization",
  "definitions": {
    "AnalyticsVisualization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "enum": [
            "AreaChart",
            "LineChart",
            "ColumnChart",
            "DataTable",
            "SingleStat",
            "DORAChart",
            "UsageOverview",
            "DoraPerformersScore",
            "DoraProjectsComparison",
            "AiImpactTable",
            "ContributionsByUserTable",
            "ContributionsPushesChart",
            "ContributionsIssuesChart",
            "ContributionsMergeRequestsChart",
            "NamespaceMetadata",
            "MergeRequestsThroughputTable",
            "BarChart",
            "StackedColumnChart"
          ]
        },
        "slug": {
          "type": "string"
        },
        "options": {
          "$ref": "#/definitions/Options"
        },
        "data": {
          "$ref": "#/definitions/Data"
        },
        "errors": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "data",
        "options",
        "type"
      ],
      "title": "AnalyticsVisualization"
    },
    "Data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "cube_analytics",
            "value_stream",
            "usage_overview",
            "usage_count",
            "dora_metrics",
            "dora_metrics_by_project",
            "ai_agent_platform_flow_metrics",
            "ai_agent_platform_flows_usage_by_user",
            "ai_impact_over_time",
            "contributions",
            "namespace_metadata",
            "merge_requests",
            "merge_request_counts",
            "mean_time_to_merge",
            "code_suggestions_acceptance_by_language",
            "code_suggestions_acceptance_by_ide",
            "code_generation_volume_over_time",
            "user_ai_usage_data",
            "code_review_requests_by_role_over_time",
            "code_review_comments_sentiment_over_time",
            "duo_agent_chat_sessions_over_time",
            "duo_users_count_over_time",
            "duo_feature_usage",
            "duo_agent_platform_agent_flows_users_count_over_time"
          ]
        },
        "query": {
          "type": "object"
        }
      },
      "required": [
        "query",
        "type"
      ],
      "title": "Data"
    },
    "Options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tooltip": {
          "$ref": "#/definitions/Tooltip"
        },
        "xAxis": {
          "$ref": "#/definitions/XAxis"
        },
        "yAxis": {
          "$ref": "#/definitions/YAxis"
        },
        "chartTooltip": {
          "$ref": "#/definitions/ChartTooltip"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Link"
          }
        },
        "decimalPlaces": {
          "type": "integer"
        },
        "unit": {
          "type": "string"
        },
        "metaText": {
          "type": "string"
        },
        "metaIcon": {
          "type": "string"
        },
        "titleIcon": {
          "type": "string"
        },
        "includeLegendAvgMax": {
          "type": "boolean"
        },
        "responsive": {
          "type": "boolean"
        },
        "fixed": {
          "type": "boolean"
        },
        "stacked": {
          "type": "string"
        },
        "refetchOnSort": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "$comment": "Limit the supported BvTableField options: https://github.com/bootstrap-vue/bootstrap-vue/blob/f5ca62faec6d5fb9e873b362b6efb153d419a7cc/src/components/table/index.d.ts#L222",
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "thClass": {
                "type": "string"
              },
              "tdClass": {
                "type": "string"
              },
              "thAlignRight": {
                "type": "boolean"
              },
              "sortable": {
                "type": "boolean"
              },
              "tooltip": {
                "type": "string"
              },
              "component": {
                "enum": [
                  "AssigneeAvatars",
                  "CalculateSum",
                  "DiffLineChanges",
                  "CalculatePercent",
                  "FormatNumber",
                  "FormatTime",
                  "FormatTimeRange",
                  "MergeRequestLink",
                  "MilestoneLink",
                  "ChangePercentageIndicator",
                  "MetricLabel",
                  "TrendLine",
                  "UserLink"
                ]
              }
            }
          }
        },
        "presentation": {
          "enum": [
            "stacked",
            "tiled"
          ]
        }
      },
      "title": "Options"
    },
    "XAxis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "XAxis"
    },
    "YAxis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "YAxis"
    },
    "Link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "href": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      },
      "required": [
        "text",
        "href"
      ],
      "title": "Link"
    },
    "ValueUnit": {
      "enum": [
        "COUNT",
        "DAYS",
        "PER_DAY",
        "PERCENT",
        "TIME_INTERVAL"
      ],
      "title": "ValueUnit"
    },
    "ChartTooltip": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "titleFormatter": {
          "enum": [
            "DATE",
            "TITLE_CASE",
            "VALUE_ONLY"
          ]
        },
        "valueUnit": {
          "$ref": "#/definitions/ValueUnit"
        },
        "contextualData": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "unit": {
                "$ref": "#/definitions/ValueUnit"
              }
            },
            "required": [
              "key",
              "label",
              "unit"
            ]
          }
        }
      },
      "title": "ChartTooltip"
    },
    "Tooltip": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "descriptionLink": {
          "type": "string",
          "format": "uri"
        }
      },
      "if": {
        "properties": {
          "descriptionLink": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "descriptionLink"
        ]
      },
      "then": {
        "properties": {
          "description": {
            "pattern": ".*%\\{linkStart\\}.*%\\{linkEnd\\}.*"
          }
        }
      },
      "required": [
        "description"
      ]
    }
  }
}
