%hr
  = f.label "", _('I forgot my password'), class: 'label-bold'
  .gl-mt-3.gl-mb-3
    = render Pajamas::ButtonComponent.new(href: reset_user_settings_password_path, method: :put) do
      = s_('JH|Recover password via email')
    - if ::Gitlab::RealNameSystem.enabled?
      = render Pajamas::ButtonComponent.new(href: "#{new_user_password_path}?phoneFormOnly") do
        = s_('JH|Recover password via phone')
