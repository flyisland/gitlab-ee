<%= s_('JH|NamespaceStorage|Group %{group_name} is about to use up its purchased storage. Please check it: %{group_url}') % { group_name: @group_name, group_url: @group_url } %>

<% unless @usage_percentage.nil? %>
<%= s_('JH|NamespaceStorage|At the time this notification was triggered, %{usage_percentage} of this group\'s purchased shared storage pool had been consumed.') % { usage_percentage: number_to_percentage(@usage_percentage, precision: 1, strip_insignificant_zeros: true) } %>

<% end %>
