<%= s_('JH|NamespaceStorage|Project %{project_name} is about to reach its usage limit. Please check it: %{project_url}') % { project_name: @project_name, project_url: @project_url } %>

<% unless @usage_percentage.nil? %>
<%= s_('JH|NamespaceStorage|At the time this notification was triggered, this project\'s repository and LFS storage usage was %{usage_percentage} of its included per-project storage limit.') % { usage_percentage: number_to_percentage(@usage_percentage, precision: 1, strip_insignificant_zeros: true) } %>

<% end %>
<%= s_('JH|NamespaceStorage|Manage your storage usage, or purchase additional storage to keep projects that exceed the included repository size from being restricted.') %>

